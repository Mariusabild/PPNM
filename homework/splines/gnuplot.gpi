set terminal pngcairo size 800,600
set output "plot.png"

set title "Linear spline interpolation"
set xlabel "x"
set ylabel "y"

plot \
"data.txt" using 1:2 with lines title "cos(x)", \
"data.txt" using 1:3 with lines title "linear spline", \
"data.txt" using 1:4 with lines title "integral", \
"data.txt" every 50 using 1:2 with points pt 7 title "data points"