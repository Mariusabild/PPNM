set terminal pngcairo size 1000,700
set output 'quasi_plot.png'

set logscale xy

set xlabel 'N'
set ylabel 'Actual error'

set title 'Pseudo-random vs Quasi-random'

plot \
'quasi_circle_data.txt' using 1:2 with linespoints title 'Pseudo-random', \
'quasi_circle_data.txt' using 1:3 with linespoints title 'Quasi-random'