set terminal pngcairo size 1000,700 enhanced
set output "timing.png"

set title "Scaling of the Jacobi eigenvalue algorithm"

set xlabel "Matrix dimension N"
set ylabel "Runtime (s)"

set logscale xy

set xrange [90:220]
set yrange [0.008:0.2]

set grid
set key top left

plot \
    "out.times.data" using 1:2 with linespoints lw 2 pt 7 title "Measured runtime"