set terminal svg size 1000,700 background "white"
set output "hydrogen.svg"

set title "Hydrogen ground state wavefunction"
set xlabel "r"
set ylabel "f(r)"

set key top right
set grid

plot \
    "hydrogen.data" using 1:2 with lines lw 2 title "Numerical", \
    "hydrogen.data" using 1:3 with lines lw 2 title "Exact: r*exp(-r)"