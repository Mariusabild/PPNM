set terminal pngcairo size 1000,700 enhanced
set output "timing.png"

set title "One sided Jacobi SVD"

set xlabel "Matrix dimension N"
set ylabel "Runtime (s)"

set logscale xy

set grid
set key top left

f(x) = a + b*x

fit f(x) "out.times.data" using (log($1)):(log($2)) via a,b

print "Slope =", b

plot \
    "out.times.data" using 1:2 with linespoints lw 2 pt 7 title "Measured runtime", \
    exp(a)*x**b title sprintf("Fit: O(N^{%.2f})", b)

    
set xrange [90:420]
set yrange [0.008:1]
